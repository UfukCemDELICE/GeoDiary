doctype html
html(class="light" lang="en")
  head
    meta(charset="utf-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title= title || 'GeoDiary'
    link(href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet")
    link(href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet")
    script(src="https://cdn.tailwindcss.com?plugins=forms,container-queries")
    script.
      tailwind.config = {
        darkMode: "class",
        theme: {
          extend: {
            "colors": {
                    "on-primary-container": "#8abda9",
                    "outline": "#707974",
                    "on-secondary-fixed": "#1c1c18",
                    "secondary-container": "#e5e2dc",
                    "primary-container": "#1b4d3e",
                    "inverse-surface": "#313030",
                    "error": "#ba1a1a",
                    "on-secondary-container": "#656460",
                    "on-tertiary-fixed-variant": "#574500",
                    "error-container": "#ffdad6",
                    "inverse-on-surface": "#f3f0ef",
                    "primary": "#003629",
                    "tertiary-fixed": "#ffe088",
                    "on-primary": "#ffffff",
                    "on-surface-variant": "#404945",
                    "surface-bright": "#fcf9f8",
                    "on-secondary-fixed-variant": "#474743",
                    "surface-dim": "#dcd9d9",
                    "on-tertiary-fixed": "#241a00",
                    "secondary-fixed-dim": "#c9c6c1",
                    "tertiary-fixed-dim": "#e9c349",
                    "surface-tint": "#376757",
                    "surface-variant": "#e5e2e1",
                    "surface-container-lowest": "#ffffff",
                    "on-error-container": "#93000a",
                    "surface-container-high": "#eae7e7",
                    "on-error": "#ffffff",
                    "primary-fixed-dim": "#9ed1bd",
                    "on-tertiary-container": "#4e3d00",
                    "background": "#fcf9f8",
                    "outline-variant": "#c0c9c3",
                    "on-surface": "#1c1b1b",
                    "surface-container-low": "#f6f3f2",
                    "tertiary": "#735c00",
                    "surface-container": "#f0eded",
                    "secondary": "#5f5e5a",
                    "on-primary-fixed": "#002117",
                    "primary-fixed": "#baeed9",
                    "surface": "#fcf9f8",
                    "inverse-primary": "#9ed1bd",
                    "on-primary-fixed-variant": "#1d4f40",
                    "secondary-fixed": "#e5e2dc",
                    "on-tertiary": "#ffffff",
                    "on-secondary": "#ffffff",
                    "surface-container-highest": "#e5e2e1",
                    "tertiary-container": "#cba72f",
                    "on-background": "#1c1b1b"
            },
            "borderRadius": {
                    "DEFAULT": "0.25rem",
                    "lg": "0.5rem",
                    "xl": "0.75rem",
                    "full": "9999px"
            },
            "spacing": {
                    "margin-mobile": "16px",
                    "margin-desktop": "40px",
                    "gutter": "24px",
                    "container-max": "1280px",
                    "unit": "8px"
            },
            "fontFamily": {
                    "label-md": ["Manrope"],
                    "headline-md": ["Manrope"],
                    "headline-lg-mobile": ["Manrope"],
                    "body-md": ["Manrope"],
                    "headline-xl": ["Manrope"],
                    "label-sm": ["Manrope"],
                    "body-lg": ["Manrope"],
                    "headline-lg": ["Manrope"]
            },
            "fontSize": {
                    "label-md": ["14px", {"lineHeight": "20px", "letterSpacing": "0.01em", "fontWeight": "500"}],
                    "headline-md": ["20px", {"lineHeight": "28px", "fontWeight": "600"}],
                    "headline-lg-mobile": ["24px", {"lineHeight": "32px", "fontWeight": "600"}],
                    "body-md": ["16px", {"lineHeight": "24px", "fontWeight": "400"}],
                    "headline-xl": ["40px", {"lineHeight": "48px", "letterSpacing": "-0.02em", "fontWeight": "700"}],
                    "label-sm": ["12px", {"lineHeight": "16px", "letterSpacing": "0.05em", "fontWeight": "600"}],
                    "body-lg": ["18px", {"lineHeight": "28px", "fontWeight": "400"}],
                    "headline-lg": ["32px", {"lineHeight": "40px", "letterSpacing": "-0.01em", "fontWeight": "600"}]
            }
          },
        },
      }
    style.
      .material-symbols-outlined {
          font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
          display: inline-block;
          vertical-align: middle;
      }
      .map-watermark {
          mask-image: linear-gradient(to bottom, rgba(0,0,0,1) 0%, rgba(0,0,0,0) 100%);
          opacity: 0.04;
      }
      .hover-lift {
          transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
      }
      .hover-lift:hover {
          transform: translateY(-2px);
      }
      .custom-scrollbar::-webkit-scrollbar { width: 4px; }
      .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
      .custom-scrollbar::-webkit-scrollbar-thumb { background: #c0c9c3; border-radius: 10px; }
      body {
          perspective: 1000px;
      }
      main {
          transform-style: preserve-3d;
      }
    block head
  body(class=currentUser ? "bg-background text-on-surface font-body-md min-h-screen flex flex-col overflow-hidden pb-16 md:pb-0" : "bg-surface text-on-surface min-h-screen flex items-center justify-center selection:bg-primary-fixed selection:text-on-primary-fixed overflow-hidden")
    if currentUser
      //- TopNavBar
      header(class="fixed top-0 w-full z-50 flex justify-between items-center px-margin-mobile md:px-margin-desktop h-16 bg-surface-bright border-b border-outline-variant")
        //- Left: Logo + Nav Links
        div(class="flex items-center gap-8")
          a(href="/diaries" class="text-headline-md font-headline-md font-bold text-primary") GeoDiary
          nav(class="hidden md:flex gap-2 items-center")
            a(class=`font-label-md text-label-md px-4 py-2 rounded-lg transition-all ${title === 'Diary map' ? 'bg-primary-container text-on-primary-container font-bold' : 'text-on-surface-variant hover:bg-surface-container'}` href="/diaries/map")
              | Map View
            a(class=`font-label-md text-label-md px-4 py-2 rounded-lg transition-all ${title === 'My diaries' ? 'bg-primary-container text-on-primary-container font-bold' : 'text-on-surface-variant hover:bg-surface-container'}` href="/diaries")
              | Journal History
        //- Right: New Entry + Avatar Dropdown
        div(class="flex items-center gap-3")
          a(class="hidden md:flex items-center gap-2 bg-primary text-on-primary font-label-md text-label-md font-bold px-4 py-2 rounded-lg shadow-sm hover:opacity-90 active:scale-95 transition-all" href="/diaries/new")
            span(class="material-symbols-outlined text-[18px]") add
            span New Entry
          //- Avatar + dropdown wrapper
          div(class="relative" id="avatar-menu-root")
            button(id="avatar-toggle" type="button" class="flex items-center justify-center w-9 h-9 rounded-full overflow-hidden border-2 border-outline-variant hover:border-primary transition-colors focus:outline-none focus:ring-2 focus:ring-primary/40")
              img(class="w-full h-full object-cover" src=(currentUser.avatarUrl || "https://lh3.googleusercontent.com/aida-public/AB6AXuAkdS2kgu3HsnbHhGt_fSS3whpBnCYVdEpHVKEM4IVKq5BN1UNrbm4N_ygvJSjm8YItrcWxcpAIRLDP9iUxUddvgQe_mPeUxbSwxd88izaYAmxZy32uRAOCqXC5VAw-oQO5m4gFhmKF3mvoBfIJfp8_xmI-mniy7TWQw7D6uHQfhDtI9vQ8ouWIxO3u_QG2VsmMTBOAggMcwx_QIIZE__Zyot3QwBSy6wKJ49_e2jVrODoX2g-mU76V") alt=currentUser.displayName)
            //- Dropdown panel (hidden by default)
            div(id="avatar-dropdown" class="hidden absolute right-0 top-[calc(100%+8px)] w-56 bg-surface-container-lowest border border-outline-variant rounded-2xl shadow-xl z-50 overflow-hidden")
              div(class="px-4 py-3 border-b border-outline-variant")
                p(class="font-label-md text-label-md text-on-surface font-semibold truncate")= currentUser.displayName
                p(class="font-label-sm text-label-sm text-on-surface-variant truncate")= currentUser.email
              div(class="p-2")
                form(action='/auth/logout' method='post' class="m-0")
                  input(type='hidden' name='_csrf' value=csrfToken)
                  button(type='submit' class="w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-error font-label-md text-label-md font-semibold hover:bg-error-container/30 transition-colors")
                    span(class="material-symbols-outlined text-[18px]") logout
                    span Log Out
      
      //- Main Content Canvas (no sidebar)
      main(class="flex-1 relative flex overflow-hidden pt-16 h-screen")
        block content
      
      //- BottomNavBar (Mobile Only)
      nav(class="md:hidden fixed bottom-0 left-0 w-full z-50 flex justify-around items-center px-4 py-3 pb-safe bg-surface shadow-[0_-4px_20px_rgba(0,0,0,0.05)] rounded-t-xl")
        a(class=`flex flex-col items-center justify-center rounded-full px-6 py-1 ${title === 'Diary map' ? 'bg-primary-container text-on-primary-container font-bold' : 'text-on-surface-variant'}` href="/diaries/map")
          span(class="material-symbols-outlined") map
          span(class="font-label-sm text-[10px]") Map
        a(class=`flex flex-col items-center justify-center rounded-full px-6 py-1 ${title === 'My diaries' ? 'bg-primary-container text-on-primary-container font-bold' : 'text-on-surface-variant'}` href="/diaries")
          span(class="material-symbols-outlined") history
          span(class="font-label-sm text-[10px]") History
      
      //- Floating Action Button (FAB)
      a(class="md:hidden fixed right-6 bottom-24 w-14 h-14 bg-primary text-on-primary rounded-full flex items-center justify-center shadow-xl z-40 transition-transform active:scale-90" href="/diaries/new")
        span(class="material-symbols-outlined text-[32px]") edit
      
      //- Avatar dropdown toggle script
      script.
        (function() {
          var toggle = document.getElementById('avatar-toggle');
          var dropdown = document.getElementById('avatar-dropdown');
          if (!toggle || !dropdown) return;
          toggle.addEventListener('click', function(e) {
            e.stopPropagation();
            dropdown.classList.toggle('hidden');
          });
          document.addEventListener('click', function() {
            dropdown.classList.add('hidden');
          });
          dropdown.addEventListener('click', function(e) {
            e.stopPropagation();
          });
        })();
    else
      block content
    block scripts
