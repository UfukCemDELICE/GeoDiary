extends ../layout
block content
  h1= diary.title
  time(datetime=diary.diaryDate.toISOString())= diary.diaryDate.toLocaleDateString()
  p= diary.content
  if diary.locationName
    p Location: #{diary.locationName}
  if diary.photo
    img.diary-photo(src=diary.photo.url alt=`Photograph for ${diary.title}`)
  a(href=`/diaries/${diary._id}/edit`) Edit
  form(action=`/diaries/${diary._id}?_method=DELETE` method='post')
    input(type='hidden' name='_csrf' value=csrfToken)
    button(type='submit') Delete
