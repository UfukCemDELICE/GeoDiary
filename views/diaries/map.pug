extends ../layout

block head
  link(rel='stylesheet' href='https://api.mapbox.com/mapbox-gl-js/v3.5.1/mapbox-gl.css')
  style.
    #map-page-root {
      position: fixed;
      top: 64px;
      left: 0;
      right: 0;
      bottom: 0;
      display: flex;
      overflow: hidden;
    }
    #diary-map {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
    }
    .mapboxgl-popup { display: none !important; }
    #map-panel {
      position: absolute;
      right: 0;
      top: 0;
      bottom: 0;
      width: 320px;
      display: flex;
      flex-direction: column;
      z-index: 10;
    }
    #panel-list, #panel-detail {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      background: rgba(255,255,255,0.97);
      backdrop-filter: blur(12px);
      border-left: 1px solid #c0c9c3;
      transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.3s;
    }
    #panel-detail {
      transform: translateX(100%);
      opacity: 0;
      pointer-events: none;
    }
    #map-panel.show-detail #panel-list {
      transform: translateX(-100%);
      opacity: 0;
      pointer-events: none;
    }
    #map-panel.show-detail #panel-detail {
      transform: translateX(0);
      opacity: 1;
      pointer-events: auto;
    }
    .entry-row:hover { background: #f0eded; }
    .mapboxgl-ctrl-bottom-right { right: 336px; }

block content
  div(id="map-page-root")
    div(id="diary-map" data-mapbox-token=mapboxToken data-markers=JSON.stringify(markers))

    //- Floating info badge
    div(class="absolute top-4 left-4 z-20 bg-white/90 backdrop-blur-md border border-outline-variant/30 px-4 py-2.5 rounded-2xl shadow-lg pointer-events-none")
      h2(class="text-label-md font-bold text-primary flex items-center gap-1.5")
        span(class="material-symbols-outlined text-[18px]" style="font-variation-settings: 'FILL' 1;") map
        span Explorer Map
      p(class="text-[11px] text-on-surface-variant mt-0.5") #{markers.length} #{markers.length === 1 ? 'memory' : 'memories'} plotted

    //- Right panel
    div(id="map-panel")

      //- === LIST STATE ===
      div(id="panel-list")
        div(class="px-5 pt-5 pb-4 border-b border-outline-variant flex items-center justify-between shrink-0")
          div
            p(class="font-headline-md text-headline-md text-on-surface font-bold") My Entries
            p(class="font-label-sm text-label-sm text-on-surface-variant mt-0.5") #{markers.length} #{markers.length === 1 ? 'location' : 'locations'}
          a(href="/diaries/new" class="flex items-center gap-1.5 bg-primary text-on-primary px-3 py-2 rounded-lg font-label-md text-label-md font-bold hover:opacity-90 active:scale-95 transition-all shadow-sm")
            span(class="material-symbols-outlined text-[16px]") add
            span New

        div(class="flex-1 overflow-y-auto custom-scrollbar p-3 flex flex-col gap-1")
          if markers.length
            each entry in markers
              div(class="entry-row group flex items-center gap-3 px-3 py-3 rounded-xl cursor-pointer transition-colors border border-transparent hover:border-outline-variant/40"
                data-entry-id=entry.id
                data-entry-title=entry.title
                data-entry-date=entry.diaryDate
                data-entry-location=entry.locationName
                data-entry-content=entry.content
                data-lng=entry.coordinates[0]
                data-lat=entry.coordinates[1])
                div(class="w-8 h-8 rounded-full bg-primary/10 flex items-center justify-center shrink-0 group-hover:bg-primary/20 transition-colors")
                  span(class="material-symbols-outlined text-primary text-[16px]" style="font-variation-settings: 'FILL' 1;") location_on
                div(class="flex-1 min-w-0")
                  p(class="font-label-md text-label-md text-on-surface font-semibold truncate")= entry.title
                  p(class="font-label-sm text-label-sm text-on-surface-variant mt-0.5")= new Date(entry.diaryDate).toLocaleDateString(undefined, {month: 'short', day: 'numeric', year: 'numeric'})
                span(class="material-symbols-outlined text-on-surface-variant text-[18px] opacity-0 group-hover:opacity-100 transition-opacity shrink-0") chevron_right
          else
            div(class="flex flex-col items-center justify-center h-full text-center px-6 py-12")
              span(class="material-symbols-outlined text-[40px] text-primary/30 mb-4") explore
              p(class="font-body-md text-on-surface-variant mb-4") No memories yet.
              a(href="/diaries/new" class="bg-primary text-on-primary px-5 py-2.5 rounded-xl font-bold text-sm hover:opacity-90 transition-opacity") + Add First Entry

        div(class="p-4 border-t border-outline-variant shrink-0")
          a(href="/diaries" class="w-full flex items-center justify-center gap-2 py-2.5 rounded-xl border border-outline-variant text-on-surface-variant font-label-md text-label-md hover:bg-surface-container transition-colors")
            span(class="material-symbols-outlined text-[18px]") list
            span View Journal History

      //- === DETAIL STATE ===
      div(id="panel-detail")
        //- Detail header with back button
        div(class="px-5 pt-5 pb-4 border-b border-outline-variant flex items-center gap-3 shrink-0")
          button(id="detail-back" type="button" class="w-8 h-8 flex items-center justify-center rounded-full hover:bg-surface-container transition-colors text-on-surface-variant shrink-0")
            span(class="material-symbols-outlined text-[20px]") arrow_back
          div(class="flex-1 min-w-0")
            p(id="detail-title" class="font-headline-md text-headline-md text-on-surface font-bold truncate") —
            p(id="detail-date" class="font-label-sm text-label-sm text-on-surface-variant mt-0.5") —

        //- Detail body
        div(class="flex-1 overflow-y-auto custom-scrollbar px-5 py-5 flex flex-col gap-4")
          //- Location badge
          div(id="detail-location-wrap" class="hidden flex items-center gap-2 px-3 py-2 bg-primary/8 rounded-xl")
            span(class="material-symbols-outlined text-primary text-[16px]" style="font-variation-settings: 'FILL' 1;") location_on
            p(id="detail-location" class="font-label-sm text-label-sm text-primary font-semibold")

          //- Story content
          div(class="bg-surface-container-low rounded-xl p-4")
            p(id="detail-content" class="font-body-md text-body-md text-on-surface-variant leading-relaxed whitespace-pre-wrap") —

        //- Detail footer actions
        div(class="px-5 py-4 border-t border-outline-variant shrink-0 flex flex-col gap-2")
          a(id="detail-edit-link" href="#" class="w-full flex items-center justify-center gap-2 py-2.5 rounded-xl bg-primary text-on-primary font-label-md text-label-md font-bold hover:opacity-90 transition-opacity")
            span(class="material-symbols-outlined text-[18px]") edit
            span Edit Entry
          form(id="detail-delete-form" action="#" method="post" class="m-0" onsubmit="return confirm('Delete this memory? This cannot be undone.')")
            input(type="hidden" name="_csrf" value=csrfToken)
            button(type="submit" class="w-full flex items-center justify-center gap-2 py-2.5 rounded-xl border border-error/40 text-error font-label-md text-label-md font-semibold hover:bg-error-container/30 transition-colors")
              span(class="material-symbols-outlined text-[18px]") delete
              span Delete Memory

block scripts
  script(src='https://api.mapbox.com/mapbox-gl-js/v3.5.1/mapbox-gl.js')
  script(src='/js/diary-list-map.js')
